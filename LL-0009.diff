diff --git a/backend/checkstyle.xml b/backend/checkstyle.xml
new file mode 100644
index 0000000..87b06ff
--- /dev/null
+++ b/backend/checkstyle.xml
@@ -0,0 +1,29 @@
+<?xml version="1.0"?>
+<!DOCTYPE module PUBLIC
+        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
+        "https://checkstyle.org/dtds/configuration_1_3.dtd">
+
+<!--
+    Règles volontairement minimales (cohérent avec DEVELOPMENT_PHILOSOPHY.md :
+    simplicité avant complexité). Pas d'exigence de Javadoc, pas de style
+    imposé type Google/Sun : uniquement des erreurs de base qui indiquent
+    un vrai problème de code.
+-->
+<module name="Checker">
+
+    <module name="LineLength">
+        <property name="max" value="120"/>
+    </module>
+
+    <module name="TreeWalker">
+        <module name="UnusedImports"/>
+        <module name="RedundantImport"/>
+        <module name="EqualsHashCode"/>
+        <module name="NeedBraces"/>
+        <module name="EmptyBlock">
+            <property name="option" value="text"/>
+        </module>
+        <module name="OneStatementPerLine"/>
+    </module>
+
+</module>
diff --git a/backend/pom.xml b/backend/pom.xml
index acf116c..44b298e 100644
--- a/backend/pom.xml
+++ b/backend/pom.xml
@@ -79,6 +79,51 @@
                     </execution>
                 </executions>
             </plugin>
+
+            <!-- Formatage automatique : `mvn spotless:apply` corrige, `mvn verify` échoue si non conforme -->
+            <plugin>
+                <groupId>com.diffplug.spotless</groupId>
+                <artifactId>spotless-maven-plugin</artifactId>
+                <version>3.8.0</version>
+                <configuration>
+                    <java>
+                        <removeUnusedImports/>
+                        <trimTrailingWhitespace/>
+                        <endWithNewline/>
+                        <indent>
+                            <spaces>true</spaces>
+                            <spacesPerTab>4</spacesPerTab>
+                        </indent>
+                    </java>
+                </configuration>
+                <executions>
+                    <execution>
+                        <goals>
+                            <goal>check</goal>
+                        </goals>
+                    </execution>
+                </executions>
+            </plugin>
+
+            <!-- Analyse statique : échoue le build sur violation (phase verify, cf. checkstyle.xml) -->
+            <plugin>
+                <groupId>org.apache.maven.plugins</groupId>
+                <artifactId>maven-checkstyle-plugin</artifactId>
+                <version>3.6.0</version>
+                <configuration>
+                    <configLocation>checkstyle.xml</configLocation>
+                    <consoleOutput>true</consoleOutput>
+                    <failOnViolation>true</failOnViolation>
+                    <violationSeverity>warning</violationSeverity>
+                </configuration>
+                <executions>
+                    <execution>
+                        <goals>
+                            <goal>check</goal>
+                        </goals>
+                    </execution>
+                </executions>
+            </plugin>
         </plugins>
     </build>
 
