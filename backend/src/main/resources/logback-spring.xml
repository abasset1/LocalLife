<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Format uniforme, quel que soit le profil -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Niveaux de logs par profil -->
    <springProfile name="local,dev">
        <logger name="com.locallife.backend" level="DEBUG"/>
    </springProfile>

    <springProfile name="test">
        <logger name="com.locallife.backend" level="INFO"/>
    </springProfile>

    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.locallife.backend" level="INFO"/>
    </springProfile>

</configuration>
