# Configuration JWT
# Générer un secret sécurisé avec : openssl rand -base64 32
JWT_SECRET=votre_secret_jwt_ici

# Clé API OpenAgenda — obligatoire uniquement pour un import réel de
# données (voir docs/02_Architecture/COLLECTOR_OPERATIONS.md). Sans
# elle, le scheduler d'import échoue silencieusement (log ERROR
# périodique, sans impact sur le reste de l'application).
OPENAGENDA_API_KEY="votre_cle_de_lecture_openagenda_ici"

# Identifiant client OAuth 2.0 Google (LL-EF-011), obtenu depuis Google
# Cloud Console (Identifiants > ID client OAuth > type "Application Web").
# Obligatoire uniquement pour la connexion/inscription via Google (voir
# docs/02_Architecture/ADR-0002-authentification-multi-provider.md) ; sans elle, POST
# /api/v1/auth/google échoue explicitement pour tout token reçu (aucune
# audience ne correspondra jamais à une valeur vide).
GOOGLE_CLIENT_ID="votre_client_id_google_ici.apps.googleusercontent.com"
