# Template des variables d'environnement pour l'application mobile LocalLife.
#
# Copier ce fichier en `.env` (jamais commité — voir .gitignore) et ajuster
# la valeur selon l'environnement ciblé (backend local, bêta, etc.).

# URL de base de l'API LocalLife (Spring Boot). Doit pointer vers l'API
# accessible depuis le téléphone/émulateur, pas vers "localhost" du poste
# de développement si testé sur un appareil physique.
EXPO_PUBLIC_API_URL=http://localhost:8080
