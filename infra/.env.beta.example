# Template des variables d'environnement pour l'environnement bêta (LL-9002).
#
# Copier ce fichier en `.env.beta` sur le VPS bêta uniquement (jamais
# commité — voir .gitignore et docs/02_Architecture/BETA_DEPLOYMENT.md),
# puis remplacer chaque valeur par une valeur réelle générée pour la bêta.
# Ne jamais réutiliser une valeur du `.env` de développement local.

# Domaine utilisé par Caddy pour obtenir le certificat HTTPS (Let's Encrypt)
LOCALLIFE_DOMAIN=locallife-beta.duckdns.org

# Base de données bêta
POSTGRES_DB=locallife
POSTGRES_USER=locallife
# Générer avec : openssl rand -base64 32
POSTGRES_PASSWORD=changez_moi

# Signature des JWT (backend/src/main/resources/application.properties)
# Générer avec : openssl rand -base64 32
JWT_SECRET=changez_moi

# Bootstrap du premier compte ADMIN (LL-8002) — peut être retiré du
# fichier une fois le premier compte ADMIN créé au démarrage.
LOCALLIFE_BOOTSTRAP_ADMIN_USERNAME=admin
LOCALLIFE_BOOTSTRAP_ADMIN_EMAIL=changez_moi@example.com
LOCALLIFE_BOOTSTRAP_ADMIN_PASSWORD=changez_moi

# OpenAgenda (LL-5006, LL-8004) — même clé et mêmes agendas Avignon qu'en
# local/dev, réutilisés ici pour alimenter la base bêta.
OPENAGENDA_API_KEY=changez_moi
OPENAGENDA_AGENDA_UID=86244142
OPENAGENDA_SOURCE_NAME=OpenAgenda Ministere culture
OPENAGENDA_AVIGNON_CULTURE_UID=79839448
OPENAGENDA_AVIGNON_CULTURE_NAME=OpenAgenda Ville d'Avignon

# Sauvegarde (LL-9004) — voir docs/02_Architecture/BACKUP_RESTORE.md.
# Nom du bucket B2 uniquement : les identifiants B2 eux-mêmes ne
# passent jamais par ce fichier, ils vivent dans la config rclone du
# VPS (~/.config/rclone/rclone.conf, hors dépôt).
B2_BUCKET_NAME=changez_moi
